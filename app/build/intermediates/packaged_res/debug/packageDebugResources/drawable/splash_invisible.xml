<?xml version="1.0" encoding="utf-8"?>
<!-- Invisible launch icon: the app must open straight onto the loading page,
     so the Android 12+ system splash shows nothing but the dark background
     (same colour as the loading page) instead of a separate logo page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
